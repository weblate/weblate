msgstr "--mkfsoptions -ს --noformat -სთან ერთად ვერ გამოიყენებთ."

#: ../pykickstart/commands/btrfs.py:264
msgid "--mkfsoptions with --noformat or --useexisting has no effect."
msgstr ""
"--mkfsoptions -ს --noformat ან --useexisting -სთან ერთად ვერ გამოიყენებთ."

#: ../pykickstart/commands/stratispool.py:147
#, fuzzy
#| msgid "--resize can only be used in conjunction with --onpart"
