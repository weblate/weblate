#: ../pykickstart/commands/device.py:144
#, python-format
msgid "%(command)s command requires a single argument: %(argument)s"
msgstr "Komandai %(command)s nepieciešams viens arguments: %(argument)s"

#: ../pykickstart/commands/mount.py:187
msgid "'--mkfsoptions' requires --reformat"
msgstr "'--mkfsoptions' nepieciešams --reformat"

#: ../pykickstart/commands/network.py:834
#: ../pykickstart/commands/network.py:1060
#, python-format
msgid "--bindto=%s is not supported for this type of device"
msgstr "--bindto=%s šim ierīces tipam netiek atbalstīts"

#. pylint: disable=no-member
#: ../pykickstart/commands/bootloader.py:323
msgid "--boot-drive accepts only one argument"
msgstr "--boot-drive pieņem tikai vienu argumentu"

#: ../pykickstart/commands/logvol.py:637 ../pykickstart/commands/logvol.py:746
msgid "--chunksize and --metadatasize are for thin pools only"
msgstr "--chunksize un --metadatasize ir paredzēti tikai plānajiem pūliem"

#: ../pykickstart/sections.py:625
msgid "--default and --nobase cannot be used together"
msgstr "--default un --nobase nevar izmantot kopā"

#: ../pykickstart/sections.py:627
msgid "--default and --nocore cannot be used together"
msgstr "--default un --nocore nevar izmantot kopā"

#: ../pykickstart/commands/ignoredisk.py:172
msgid "--interactive option of ignoredisk command is no longer supported."
msgstr "Komandas ignoredisk opcija --interactive vairs netiek atbalstīta."

#: ../pykickstart/commands/logvol.py:813 ../pykickstart/commands/logvol.py:870
#: ../pykickstart/commands/partition.py:685 ../pykickstart/commands/raid.py:725
msgid "--mkfsoptions and --fsprofile cannot be used together."
msgstr "--mkfsoptions un --fsprofile nevar izmantot kopā."

#: ../pykickstart/commands/logvol.py:810 ../pykickstart/commands/logvol.py:867
#: ../pykickstart/commands/partition.py:682 ../pykickstart/commands/raid.py:722
msgid "--mkfsoptions with --noformat has no effect."
msgstr "--mkfsoptions ar --noformat neko nedara."

#: ../pykickstart/commands/btrfs.py:264
msgid "--mkfsoptions with --noformat or --useexisting has no effect."
msgstr "--mkfsoptions ar --noformat vai --useexisting neko nedara."

#: ../pykickstart/commands/partition.py:611
msgid "--resize can only be used in conjunction with --onpart"
msgstr "--resize var izmantot tikai kopā ar --onpart"

#: ../pykickstart/commands/logvol.py:681
msgid "--resize can only be used in conjunction with --useexisting"
msgstr "--resize var izmantot tikai kopā ar --useexisting"

#: ../pykickstart/commands/logvol.py:684
msgid "--resize requires --size to indicate new size"
msgstr "--resize nepieciešams --size, lai norādītu jauno izmēru"

#: ../pykickstart/commands/partition.py:614
msgid "--resize requires --size to specify new size"
msgstr "--resize nepieciešams --size, lai norādītu jauno izmēru"

#: ../pykickstart/commands/logvol.py:785
msgid "--size and --percent cannot both be specified for the same logvol"
msgstr "--size un --percent nevar norādīt vienam un tam pašam logvol"

#: ../pykickstart/commands/logvol.py:627 ../pykickstart/commands/logvol.py:737
msgid "--thin and --thinpool cannot both be specified for the same logvol"
msgstr "--thin un --thinpool nevar norādīt vienam un tam pašam logvol"

#: ../pykickstart/commands/logvol.py:632 ../pykickstart/commands/logvol.py:741
msgid "--thin requires --poolname to specify pool name"
msgstr "--thin nepieciešams --poolname, lai norādītu pūla nosaukumu"

#: ../pykickstart/commands/dmraid.py:91
#, python-format
msgid ""
"A DM RAID device with the name %(name)s and devices %(devices)s has already "
"been defined."
msgstr ""
"DM RAID ierīce ar nosaukumu %(name)s un ierīcēm %(devices)s jau ir definēta."

#: ../pykickstart/commands/fcoe.py:143
#, python-format
msgid "A FCOE device with the name %s has already been defined."
msgstr "FCOE ierīce ar nosaukumu %s jau ir definēta."

#: ../pykickstart/commands/raid.py:458
#, python-format
msgid "A RAID device with the name %s has already been defined."
msgstr "RAID ierīce ar nosaukumu %s jau ir definēta."

#: ../pykickstart/commands/btrfs.py:233
#, python-format
msgid "A btrfs volume with the mountpoint %s has already been defined."
msgstr "btrfs sējums ar montēšanas punktu %s jau ir definēts."

#: ../pykickstart/commands/group.py:95
#, python-format
msgid "A group with the name %s has already been defined."
msgstr "Grupa ar nosaukumu %s jau ir definēta."

#: ../pykickstart/commands/logvol.py:480
#, python-format
msgid ""
"A logical volume with the name %(logical_volume_name)s has already been "
"defined in volume group %(volume_group)s."
msgstr ""
"Loģiskais sējums ar nosaukumu %(logical_volume_name)s jau ir definēts sējumu "
"grupā %(volume_group)s."

#: ../pykickstart/commands/device.py:156
#, python-format
msgid "A module with the name %s has already been defined."
msgstr "Modulis ar nosaukumu %s jau ir definēts."

#: ../pykickstart/commands/network.py:478
#, python-format
msgid "A network device with the name %s has already been defined."
msgstr "Tīkla ierīce ar nosaukumu %s jau ir definēta."

#: ../pykickstart/commands/partition.py:448
#, python-format
msgid "A partition with the mountpoint %s has already been defined."
msgstr "Nodalījums ar montēšanas punktu %s jau ir definēts."

#: ../pykickstart/commands/repo.py:291
#, python-format
msgid "A repo with the name %s has already been defined."
msgstr "Repozitorijs ar nosaukumu %s jau ir definēts."

#: ../pykickstart/commands/keyboard.py:163 ../pykickstart/commands/rootpw.py:85
#: ../pykickstart/commands/rootpw.py:142 ../pykickstart/commands/sshpw.py:160
#, python-format
msgid "A single argument is expected for the %s command"
msgstr "Komandai %s tiek gaidīts viens arguments"

#: ../pykickstart/commands/user.py:202
#, python-format
msgid "A user with the name %s has already been defined."
msgstr "Lietotājs ar nosaukumu %s jau ir definēts."

#: ../pykickstart/commands/volgroup.py:180
#, python-format
msgid "A volgroup with the name %s has already been defined."
msgstr "volgroup ar nosaukumu %s jau ir definēts."

#: ../pykickstart/commands/zfcp.py:132
msgid "A zfcp with this information has already been defined."
msgstr "zfcp ar šo informāciju jau ir definēts."

#: ../pykickstart/commands/nvdimm.py:155
#, python-format
msgid "Action %(action)s requires --namespace argument to be set"
msgstr "Darbībai %(action)s jābūt iestatītam argumentam --namespace"

#: ../pykickstart/commands/nvdimm.py:162
#, python-format
msgid ""
"Action %(action)s requires --namespace or --blockdevs argument to be set"
msgstr ""
"Darbībai %(action)s jābūt iestatītam argumentam --namespace vai --blockdevs"

#: ../pykickstart/commands/nvdimm.py:158
#, python-format
msgid ""
"Action %(action)s with mode %(mode)s requires --sectorsize argument to be set"
msgstr ""
"Darbībai %(action)s režīmā %(mode)s jābūt iestatītam argumentam --sectorsize"

#: ../pykickstart/commands/logvol.py:847
msgid "Adding a cache to an existing logical volume is not supported"
msgstr "Kešatmiņas pievienošana esošam loģiskajam sējumam netiek atbalstīta"

#: ../pykickstart/commands/nvdimm.py:150
#, python-format
msgid "An action %(action)s on devices %(blockdevs)s has already been defined."
msgstr "Darbība %(action)s ierīcēm %(blockdevs)s jau ir definēta."

#: ../pykickstart/commands/nvdimm.py:147
#, python-format
msgid ""
"An action %(action)s on namespace %(namespace)s has already been defined."
msgstr "Darbība %(action)s nosaukumvietai %(namespace)s jau ir definēta."

#: ../pykickstart/commands/sshkey.py:109 ../pykickstart/commands/sshpw.py:170
#, python-format
msgid "An ssh user with the name %s has already been defined."
msgstr "ssh lietotājs ar nosaukumu %s jau ir definēts."

#: ../pykickstart/commands/timezone.py:266
#: ../pykickstart/commands/timezone.py:341
#, python-format
msgid "At least one option and/or an argument are expected for the  %s command"
msgstr "Komandai  %s tiek gaidīta vismaz viena opcija un/vai arguments"

#: ../pykickstart/commands/network.py:752
#: ../pykickstart/commands/network.py:1055
msgid ""
"Bad format of --bridgeopts, expecting key=value options separated by ','"
msgstr ""
"Nepareizs --bridgeopts formāts, tiek gaidītas ar ',' atdalītas opcijas "
"atslēga=vērtība"

#: ../pykickstart/commands/logvol.py:929
#: ../pykickstart/commands/partition.py:749 ../pykickstart/commands/raid.py:799
msgid "Btrfs file system is not supported"
msgstr "Btrfs failu sistēma netiek atbalstīta"

#: ../pykickstart/commands/logvol.py:855
msgid "Cache needs to have a list of (fast) PVs specified"
msgstr "Kešatmiņai jānorāda (ātro) PV saraksts"

#: ../pykickstart/commands/logvol.py:859
msgid "Cache needs to have size specified"
msgstr "Kešatmiņai jānorāda izmērs"

#: ../pykickstart/commands/logging.py:80
msgid "Can't specify --port without --host."
msgstr "--port nevar norādīt bez --host."

#: ../pykickstart/commands/multipath.py:98
#, python-format
msgid "Device '%(device)s' is already used in multipath '%(multipathdev)s'"
msgstr ""
"Ierīce „%(device)s” jau tiek izmantota vairākceļu ierīcē „%(multipathdev)s”"

#: ../pykickstart/commands/rhsm.py:109
msgid "Empty string is not a valid activation key."
msgstr "Tukša virkne nav derīga aktivizācijas atslēga."

#. pylint: disable=no-member
#: ../pykickstart/load.py:81 ../pykickstart/load.py:84
#, python-format
msgid "Error accessing URL \"%s\""
msgstr "Kļūda, piekļūstot URL „%s”"

#: ../pykickstart/load.py:109
#, python-format
msgid "Error copying file: %s"
msgstr "Kļūda, kopējot failu: %s"

#: ../pykickstart/load.py:99
#, python-format
msgid "Error opening file: %s"
msgstr "Kļūda, atverot failu: %s"

#: ../tools/ksvalidator.py:87
#, python-format
msgid ""
"Error reading %(filename)s:\n"
"%(version)s"
msgstr ""
"Kļūda, nolasot %(filename)s:\n"
"%(version)s"

#: ../pykickstart/load.py:79
#, python-format
msgid "Error securely accessing URL \"%s\""
msgstr "Kļūda, droši piekļūstot URL „%s”"

#: ../pykickstart/load.py:66
#, python-format
msgid "Error writing file \"%s\":"
msgstr "Kļūda, rakstot failu „%s”:"

#: ../tools/ksflatten.py:70
#, python-format
msgid "Failed to open output file '%(filename)s' : %(error_msg)s"
msgstr "Neizdevās atvērt izvades failu „%(filename)s” : %(error_msg)s"

#: ../tools/ksflatten.py:63
#, python-format
msgid "Failed to parse kickstart file '%(filename)s' : %(error_msg)s"
msgstr "Neizdevās parsēt kickstart failu „%(filename)s” : %(error_msg)s"

#: ../tools/ksflatten.py:60
#, python-format
msgid "Failed to read kickstart file '%(filename)s' : %(error_msg)s"
msgstr "Neizdevās nolasīt kickstart failu „%(filename)s” : %(error_msg)s"

#: ../tools/ksvalidator.py:109
#, python-format
msgid ""
"File uses a deprecated option or command.\n"
"%s"
msgstr ""
"Fails izmanto novecojušu opciju vai komandu.\n"
"%s"

#: ../tools/ksvalidator.py:117
#, python-format
msgid "General error in input file:  %s"
msgstr "Vispārēja kļūda ievades failā:  %s"

#: ../tools/ksvalidator.py:114
msgid "General kickstart error in input file"
msgstr "Vispārēja kickstart kļūda ievades failā"

#: ../pykickstart/parser.py:439
msgid "Group cannot specify both --nodefaults and --optional"
msgstr "Grupai nevar norādīt gan --nodefaults, gan --optional"

#: ../pykickstart/commands/network.py:954
msgid "If network --interfacename contains a '.', valid vlan id should follow."
msgstr "Ja network --interfacename satur '.', tam jāseko derīgam vlan ID."

#: ../pykickstart/commands/network.py:963
msgid ""
"If network --interfacename starts with 'vlan', valid vlan id should follow."
msgstr "Ja network --interfacename sākas ar 'vlan', tam jāseko derīgam vlan ID."

#: ../pykickstart/base.py:215
#, python-format
msgid ""
"Ignoring deprecated command on line %(lineno)s:  The %(cmd)s command has "
"been deprecated and no longer has any effect.  It may be removed from future "
"releases, which will result in a fatal error from kickstart.  Please modify "
"your kickstart file to remove this command."
msgstr ""
"Tiek ignorēta novecojusi komanda %(lineno)s. rindā:  komanda %(cmd)s ir "
"novecojusi un vairs neko nedara.  Tā var tikt noņemta nākamajos laidienos, "
"un tad kickstart izraisīs fatālu kļūdu.  Lūdzu, izmainiet kickstart failu, "
"lai noņemtu šo komandu."

#: ../pykickstart/options.py:190
#, python-format
msgid ""
"Ignoring deprecated option on line %(lineno)s:  The %(option)s option has "
"been deprecated and no longer has any effect.  It may be removed from future "
"releases, which will result in a fatal error from kickstart.  Please modify "
"your kickstart file to remove this option."
msgstr ""
"Tiek ignorēta novecojusi opcija %(lineno)s. rindā:  opcija %(option)s ir "
"novecojusi un vairs neko nedara.  Tā var tikt noņemta nākamajos laidienos, "
"un tad kickstart izraisīs fatālu kļūdu.  Lūdzu, izmainiet kickstart failu, "
"lai noņemtu šo opciju."

#: ../pykickstart/commands/ignoredisk.py:165
#, python-format
msgid ""
"Ignoring deprecated option on line %s:  The ignoredisk command no longer "
"supports --interactive option.  In future releases, this will result in a "
"fatal error from kickstart. Please modify your kickstart file to remove the "
"option."
msgstr ""
"Tiek ignorēta novecojusi opcija %s. rindā:  komanda ignoredisk vairs "
"neatbalsta opciju --interactive.  Nākamajos laidienos tas izraisīs fatālu "
"kickstart kļūdu. Lūdzu, izmainiet kickstart failu, lai noņemtu šo opciju."

#: ../pykickstart/commands/zerombr.py:62
#, python-format
msgid ""
"Ignoring deprecated option on line %s:  The zerombr command no longer takes "
"any options.  In future releases, this will result in a fatal error from "
"kickstart.  Please modify your kickstart file to remove any options."
msgstr ""
"Tiek ignorēta novecojusi opcija %s. rindā:  komanda zerombr vairs nepieņem "
"nekādas opcijas.  Nākamajos laidienos tas izraisīs fatālu kickstart kļūdu.  "
"Lūdzu, izmainiet kickstart failu, lai noņemtu visas opcijas."

#: ../pykickstart/parser.py:92
#, python-format
msgid "Illegal url for %%ksappend: %s"
msgstr "Neatļauts URL %%ksappend: %s"

#: ../tools/ksshell.py:218
#, python-format
msgid "Internal command %s not recognized."
msgstr "Iekšējā komanda %s nav atpazīta."

#: ../pykickstart/commands/autopart.py:285
#, python-format
msgid "Invalid autopart type: %s"
msgstr "Nederīgs autopart tips: %s"

#: ../pykickstart/commands/btrfs.py:129
#, python-format
msgid "Invalid btrfs level: %s"
msgstr "Nederīgs btrfs līmenis: %s"

#: ../pykickstart/commands/logvol.py:863
#, python-format
msgid "Invalid cache mode given: %s"
msgstr "Norādīts nederīgs kešatmiņas režīms: %s"

#: ../pykickstart/commands/mount.py:184
#, python-format
msgid "Invalid mount point '%s' given"
msgstr "Norādīts nederīgs montēšanas punkts „%s”"

#: ../pykickstart/commands/raid.py:348
#, python-format
msgid "Invalid raid level: %s"
msgstr "Nederīgs raid līmenis: %s"

#: ../pykickstart/commands/realm.py:63
#, python-format
msgid "Invalid realm arguments: %s"
msgstr "Nederīgi realm argumenti: %s"

#: ../pykickstart/commands/snapshot.py:90
#, python-format
msgid "Invalid snapshot when parameter: %s"
msgstr "Nederīgs momentuzņēmuma parametrs when: %s"

#: ../pykickstart/commands/upgrade.py:104
#, python-format
msgid ""
"Kickstart command %(command)s does not accept empty parameter %(parameter)s"
msgstr "Kickstart komanda %(command)s nepieņem tukšu parametru %(parameter)s"

#: ../pykickstart/commands/autopart.py:47 ../pykickstart/commands/cdrom.py:41
#: ../pykickstart/commands/eula.py:65 ../pykickstart/commands/hmc.py:46
#, python-format
msgid "Kickstart command %s does not take any arguments"
msgstr "Kickstart komanda %s nepieņem nekādus argumentus"

#: ../pykickstart/commands/updates.py:64
#, python-format
msgid "Kickstart command %s only takes one argument"
msgstr "Kickstart komanda %s pieņem tikai vienu argumentu"

#: ../pykickstart/commands/keyboard.py:56 ../pykickstart/commands/key.py:61
#: ../pykickstart/commands/mouse.py:65
#, python-format
msgid "Kickstart command %s requires one argument"
msgstr "Kickstart komandai %s nepieciešams viens arguments"

#: ../pykickstart/commands/displaymode.py:108
msgid "Kickstart command cmdline does not support --non-interactive parameter"
msgstr "Kickstart komanda cmdline neatbalsta parametru --non-interactive"

#: ../pykickstart/commands/eula.py:68
msgid "Kickstart command eula expects the --agreed option"
msgstr "Kickstart komanda eula gaida opciju --agreed"

#: ../tools/ksflatten.py:38
msgid "Kickstart version to use for interpreting config"
msgstr "Kickstart versija, ko izmantot konfigurācijas interpretēšanai"

#: ../pykickstart/commands/raid.py:440
msgid "Members may not be specified for preexisting RAID device"
msgstr "Iepriekš eksistējošai RAID ierīcei nevar norādīt dalībniekus"

#: ../pykickstart/commands/volgroup.py:172
msgid "Members may not be specified for preexisting volgroup"
msgstr "Iepriekš eksistējošam volgroup nevar norādīt dalībniekus"

#: ../pykickstart/commands/repo.py:337
msgid "Method must be a url to be added to the repo list."
msgstr "Lai pievienotu repozitoriju sarakstam, metodei jābūt url."

#: ../pykickstart/commands/realm.py:46
msgid "Missing realm command arguments"
msgstr "Trūkst realm komandas argumentu"

#: ../tools/ksflatten.py:47
msgid "Need to specify a config to flatten"
msgstr "Jānorāda saplacināmā konfigurācija"

#: ../pykickstart/commands/logvol.py:760
msgid ""
"No size given for logical volume. Use one of --useexisting, --noformat, --"
"size, --percent, or --hibernation."
msgstr ""
"Loģiskajam sējumam nav norādīts izmērs. Izmantojiet vienu no --"
"useexisting, --noformat, --size, --percent vai --hibernation."

#: ../pykickstart/commands/repo.py:280
#, python-format
msgid "One of -%(options_list)s options must be specified for repo command."
msgstr "Komandai repo jānorāda viena no opcijām -%(options_list)s."

#: ../pykickstart/commands/url.py:194
#, python-format
msgid "One of -%(options_list)s options must be specified for url command."
msgstr "Komandai url jānorāda viena no opcijām -%(options_list)s."

#: ../pykickstart/commands/services.py:76
msgid "One of --disabled or --enabled must be provided."
msgstr "Jānorāda viens no --disabled vai --enabled."

#: ../pykickstart/commands/ignoredisk.py:133
msgid ""
"One of --drives , --only-use , or --interactive must be specified for "
"ignoredisk command."
msgstr ""
"Komandai ignoredisk jānorāda viens no --drives, --only-use vai --interactive."

#: ../pykickstart/commands/ignoredisk.py:90
#: ../pykickstart/commands/ignoredisk.py:175
msgid "One of --drives or --only-use must be specified for ignoredisk command."
msgstr "Komandai ignoredisk jānorāda viens no --drives vai --only-use."

#: ../pykickstart/commands/driverdisk.py:138
msgid "One of --source or partition must be specified for driverdisk command."
msgstr "Komandai driverdisk jānorāda viens no --source vai nodalījums."

#: ../pykickstart/commands/driverdisk.py:183
msgid ""
"One of --source, --biospart, or partition must be specified for driverdisk "
"command."
msgstr ""
"Komandai driverdisk jānorāda viens no --source, --biospart vai nodalījums."

#: ../pykickstart/commands/keyboard.py:169
msgid ""
"One of --xlayouts, --vckeymap options with value(s) or argument is expected "
"for the keyboard command"
msgstr ""
"Komandai keyboard tiek gaidīta viena no opcijām --xlayouts, --vckeymap ar "
"vērtību(-ām) vai arguments"

#: ../pykickstart/commands/harddrive.py:88
msgid "One of biospart or partition options must be specified."
msgstr "Jānorāda viena no opcijām biospart vai partition."

#: ../pykickstart/commands/timezone.py:279
#: ../pykickstart/commands/timezone.py:354
#, python-format
msgid "One or zero arguments are expected for the %s command"
msgstr "Komandai %s tiek gaidīts viens vai neviens arguments"

#: ../pykickstart/commands/zfcp.py:209
msgid "Only --devnum or --devnum with --wwpn and --fcplun are allowed."
msgstr "Atļauts tikai --devnum vai --devnum ar --wwpn un --fcplun."

#: ../pykickstart/commands/repo.py:283
#, python-format
msgid "Only one of %(options_list)s options may be specified for repo command."
msgstr "Komandai repo var norādīt tikai vienu no opcijām %(options_list)s."

#: ../pykickstart/commands/url.py:197
#, python-format
msgid "Only one of %(options_list)s options may be specified for url command."
msgstr "Komandai url var norādīt tikai vienu no opcijām %(options_list)s."

#: ../pykickstart/commands/driverdisk.py:180
msgid ""
"Only one of --biospart and --source may be specified for driverdisk command."
msgstr "Komandai driverdisk var norādīt tikai vienu no --biospart un --source."

#: ../pykickstart/commands/driverdisk.py:178
msgid ""
"Only one of --biospart and partition may be specified for driverdisk command."
msgstr ""
"Komandai driverdisk var norādīt tikai vienu no --biospart un nodalījuma."

#: ../pykickstart/commands/nvdimm.py:142
msgid ""
"Only one of --namespace and --blockdevs device specifications can be used"
msgstr ""
"Var izmantot tikai vienu no ierīču specifikācijām --namespace un --blockdevs"

#: ../pykickstart/commands/rescue.py:77
msgid ""
"Only one of --nomount and --romount may be specified for rescue command."
msgstr "Komandai rescue var norādīt tikai vienu no --nomount un --romount."

#: ../pykickstart/commands/autopart.py:615
#: ../pykickstart/commands/logvol.py:917
