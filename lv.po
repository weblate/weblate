msgstr "Loģiskais sējums ar nosaukumu %s jau ir definēts sējumu grupā %s."

#: ../pykickstart/commands/logvol.py:428 ../pykickstart/commands/logvol.py:511
msgid "The logvol and autopart commands can't be used at the same time"
msgstr "Komandas logvol un autopart nevar izmantot vienlaikus"

#: ../pykickstart/commands/logvol.py:460
