msgstr "Komandai url var norādīt tikai vienu no --url un --mirrorlist."

#: ../pykickstart/commands/url.py:173
msgid "One of --url or --mirrorlist must be specified for url command."
msgstr "Komandai url jānorāda viens no --url vai --mirrorlist."

