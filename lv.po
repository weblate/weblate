msgstr "Iepriekš eksistējošai RAID ierīcei nevar norādīt dalībniekus"

#: ../pykickstart/commands/raid.py:345
#, python-format
msgid "A RAID device with the name %s has already been defined."
msgstr "RAID ierīce ar nosaukumu %s jau ir definēta."

#: ../pykickstart/commands/raid.py:447 ../pykickstart/commands/raid.py:489
msgid "The raid and autopart commands can't be used at the same time"
msgstr "Komandas raid un autopart nevar izmantot vienlaikus"

#: ../pykickstart/commands/raid.py:493
msgid "The raid and mount commands can't be used at the same time"
msgstr "Komandas raid un mount nevar izmantot vienlaikus"

#: ../pykickstart/commands/raid.py:511 ../pykickstart/commands/logvol.py:569
