msgstr ""
"Komandai ignoredisk jānorāda viens no --drives, --only-use vai --interactive."

#: ../pykickstart/commands/nvdimm.py:118
#, python-format
msgid "Unexpected arguments to nvdimm command: %(arguments)s"
msgstr "Negaidīti argumenti komandai nvdimm: %(arguments)s"

#: ../pykickstart/commands/nvdimm.py:122
